{
  "algorithm": "urn:a2a:trust:discount:exponential-decay-v1",
  "description": "Test vectors for the Exponential Decay v1 Trust Discount algorithm.",
  "parameters": {
    "max_rho": 0.85,
    "volume_half_life_ate": 5000,
    "age_weight": 0.10,
    "attestation_success_floor": 0.90
  },
  "vectors": [
    {
      "id": "ed-001",
      "description": "All inputs zero → rho must be 0.0",
      "inputs": {
        "federation_age_days": 0,
        "cross_exchange_volume_ate": 0.0,
        "cross_exchange_tx_count": 0,
        "attestation_success_rate": 1.0
      },
      "expected_rho": 0.0
    },
    {
      "id": "ed-002",
      "description": "Early federation with small volume",
      "inputs": {
        "federation_age_days": 30,
        "cross_exchange_volume_ate": 1000.0,
        "cross_exchange_tx_count": 10,
        "attestation_success_rate": 0.98
      },
      "expected_rho": 0.106,
      "tolerance": 0.01
    },
    {
      "id": "ed-003",
      "description": "At volume half-life",
      "inputs": {
        "federation_age_days": 90,
        "cross_exchange_volume_ate": 5000.0,
        "cross_exchange_tx_count": 50,
        "attestation_success_rate": 0.95
      },
      "expected_rho": 0.400,
      "tolerance": 0.02
    },
    {
      "id": "ed-004",
      "description": "Three half-lives of volume — near ceiling",
      "inputs": {
        "federation_age_days": 180,
        "cross_exchange_volume_ate": 15000.0,
        "cross_exchange_tx_count": 150,
        "attestation_success_rate": 0.95
      },
      "expected_rho": 0.709,
      "tolerance": 0.02
    },
    {
      "id": "ed-005",
      "description": "Large volume and full year — approaching max_rho",
      "inputs": {
        "federation_age_days": 365,
        "cross_exchange_volume_ate": 50000.0,
        "cross_exchange_tx_count": 500,
        "attestation_success_rate": 0.96
      },
      "expected_rho": 0.850,
      "tolerance": 0.005
    },
    {
      "id": "ed-006",
      "description": "Attestation below floor → rho = 0",
      "inputs": {
        "federation_age_days": 365,
        "cross_exchange_volume_ate": 50000.0,
        "cross_exchange_tx_count": 500,
        "attestation_success_rate": 0.89
      },
      "expected_rho": 0.0
    },
    {
      "id": "ed-007",
      "description": "High age, zero volume — only age component",
      "inputs": {
        "federation_age_days": 365,
        "cross_exchange_volume_ate": 0.0,
        "cross_exchange_tx_count": 0,
        "attestation_success_rate": 0.95
      },
      "expected_rho": 0.100,
      "tolerance": 0.005
    }
  ]
}
